def resolve_data_source(cur, data_source_id, current_user):
    if data_source_id is None:
        return None

    cur.execute("""
        SELECT id, name, source_type, data_format, connection_value, is_active, user_id
        FROM data_sources
        WHERE id = %s
    """, (data_source_id,))
    ds = cur.fetchone()

    if not ds:
        raise HTTPException(status_code=404, detail="Data source não encontrado")

    if ds[5] is not True:
        raise HTTPException(status_code=400, detail="Data source inativo")

    if not can_access_owned_resource(current_user, ds[6]):
        raise HTTPException(status_code=403, detail="Você não tem permissão para usar esta data source")

    return ds


def resolve_code_source(cur, code_source_id, current_user):
    cur.execute("""
        SELECT id, source_mode, language, inline_code,
               git_url, git_branch, git_file_path, git_secret_name, user_id
        FROM code_sources
        WHERE id = %s
    """, (code_source_id,))
    cs = cur.fetchone()

    if not cs:
        raise HTTPException(status_code=404, detail="Code source não encontrado")

    if not can_access_owned_resource(current_user, cs[8]):
        raise HTTPException(status_code=403, detail="Você não tem permissão para usar este code source")

    return cs


def insert_job_run(
    req: JobFromSourceRequest,
    parsed: dict,
    status: str,
    language: str,
    started_at,
    finished_at,
    has_data_source: bool,
    user_id: int | None,
):
    stdout_log_path = None
    stderr_log_path = None

    if parsed["result_path"]:
        base_dir = str(Path(parsed["result_path"]).parent)
        stdout_log_path = f"{base_dir}/stdout.log"
        stderr_log_path = f"{base_dir}/stderr.log"

    with get_db_connection() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                INSERT INTO job_runs (
                    job_name, language, status, user_id, data_source_id, code_source_id,
                    cpu_request, memory_limit, ephemeral_storage_limit,
                    has_data_source, result_path, log_path,
                    started_at, finished_at
                )
                VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
                RETURNING id
            """, (
                parsed["job_name"] or req.job_base_name,
                language,
                status,
                user_id,
                req.data_source_id,
                req.code_source_id,
                req.cpus,
                req.ram_limit_gb,
                req.ephemeral_storage_gb,
                has_data_source,
                parsed["result_path"],
                stdout_log_path,
                started_at,
                finished_at,
            ))
            run_id = cur.fetchone()[0]
        conn.commit()

    return run_id, stdout_log_path, stderr_log_path


@app.post("/run/python/by-source")
def run_python_job_by_source(req: JobFromSourceRequest, request: Request):
    current_user = get_current_user_or_401(request)

    started_at = datetime.now(timezone.utc)
    ds = None
    has_data_source = req.data_source_id is not None
    code_dir = ""

    with get_db_connection() as conn:
        with conn.cursor() as cur:
            ds = resolve_data_source(cur, req.data_source_id, current_user)
            cs = resolve_code_source(cur, req.code_source_id, current_user)

            if cs[2] != "python":
                raise HTTPException(status_code=400, detail="Este endpoint executa apenas code_source python")

            if cs[1] == "inline":
                if not cs[3]:
                    raise HTTPException(status_code=400, detail="inline_code vazio")
                code_dir = materialize_inline_code_python(req.job_base_name, cs[3])
            elif cs[1] == "gitlab":
                raise HTTPException(status_code=400, detail="Execução GitLab ainda será ligada no próximo passo")
            else:
                raise HTTPException(status_code=400, detail="source_mode inválido")

    data_format = ds[3] if ds else ""
    data_path = ds[4] if ds else ""

    cmd = [
        "/app/run-python-job-v2.sh",
        req.job_base_name,
        data_format,
        data_path,
        req.output_subdir_base,
        req.ram_limit_gb,
        req.cpus,
        req.ephemeral_storage_gb,
        code_dir,
    ]

    result = subprocess.run(cmd, capture_output=True, text=True, check=False)
    parsed = parse_stdout(result.stdout)
    finished_at = datetime.now(timezone.utc)
    status = "completed" if result.returncode == 0 else "failed"

    runtime = inspect_job_runtime(parsed["job_name"])
    oom_killed = runtime["terminated_reason"] == "OOMKilled"
    effective_success = (result.returncode == 0) and not oom_killed

    if oom_killed:
        status = "failed"
        display_message = "A execução excedeu o limite de memória (OOMKilled). Aumente a RAM e tente novamente."
    elif effective_success:
        status = "completed"
        display_message = f"Execução concluída com sucesso. Job: {parsed['job_name']}"
    else:
        status = "failed"
        display_message = "A execução falhou. Consulte stdout, stderr e logs do Job."

    run_id, stdout_log_path, stderr_log_path = insert_job_run(
        req=req,
        parsed=parsed,
        status=status,
        language="python",
        started_at=started_at,
        finished_at=finished_at,
        has_data_source=has_data_source,
        user_id=current_user["id"],
    )

    return {
        "success": effective_success,
        "returncode": result.returncode,
        "run_id": run_id,
        "job_name": parsed["job_name"],
        "result_path": parsed["result_path"],
        "stdout_log_path": stdout_log_path,
        "stderr_log_path": stderr_log_path,
        "stdout": result.stdout,
        "stderr": result.stderr,
        "display_message": display_message,
        "oom_killed": oom_killed,
        "runtime": runtime,
        "command": cmd,
        "has_data_source": has_data_source,
        "data_source": {
            "id": ds[0],
            "name": ds[1],
            "source_type": ds[2],
            "data_format": ds[3],
            "connection_value": ds[4],
            "user_id": ds[6],
        } if ds else None,
        "code_source": {
            "id": cs[0],
            "source_mode": cs[1],
            "language": cs[2],
            "git_url": cs[4],
            "git_branch": cs[5],
            "git_file_path": cs[6],
            "git_secret_name": cs[7],
            "user_id": cs[8],
        }
    }


