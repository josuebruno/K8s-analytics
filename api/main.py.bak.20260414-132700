@app.post("/code-sources")
def create_code_source(req: CodeSourceCreate, request: Request):
    current_user = get_current_user_or_401(request)

    if req.source_mode not in ("inline", "gitlab"):
        raise HTTPException(status_code=400, detail="source_mode deve ser 'inline' ou 'gitlab'")

    if req.language not in ("python", "r", "python+r"):
        raise HTTPException(status_code=400, detail="language deve ser 'python', 'r' ou 'python+r'")

    if req.source_mode == "inline":
        if not req.inline_code:
            raise HTTPException(status_code=400, detail="inline_code é obrigatório para source_mode=inline")
        if req.git_url or req.git_branch or req.git_file_path or req.git_secret_name:
            raise HTTPException(status_code=400, detail="campos git não devem ser enviados em source_mode=inline")

    if req.source_mode == "gitlab":
        if not req.git_url:
            raise HTTPException(status_code=400, detail="git_url é obrigatório para source_mode=gitlab")
        if not req.git_file_path:
            raise HTTPException(status_code=400, detail="git_file_path é obrigatório para source_mode=gitlab")
        if req.inline_code:
            raise HTTPException(status_code=400, detail="inline_code não deve ser enviado em source_mode=gitlab")

    with get_db_connection() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                INSERT INTO code_sources (
                    source_mode, language, inline_code, git_url,
                    git_branch, git_file_path, git_secret_name, user_id
                )
                VALUES (%s, %s, %s, %s, %s, %s, %s, %s)
                RETURNING id
            """, (
                req.source_mode,
                req.language,
                req.inline_code,
                req.git_url,
                req.git_branch,
                req.git_file_path,
                req.git_secret_name,
                current_user["id"],
            ))
            new_id = cur.fetchone()[0]
        conn.commit()

    return {"success": True, "id": new_id, "user_id": current_user["id"]}


