apiVersion: apps/v1
kind: Deployment
metadata:
  name: analytics-frontend-modern
  namespace: analytics-system
spec:
  replicas: 1
  selector:
    matchLabels:
      app: analytics-frontend-modern
  template:
    metadata:
      labels:
        app: analytics-frontend-modern
    spec:
      nodeSelector:
        kubernetes.io/hostname: masterlab01
      tolerations:
        - key: "node-role.kubernetes.io/control-plane"
          operator: "Exists"
          effect: "NoSchedule"
        - key: "node-role.kubernetes.io/master"
          operator: "Exists"
          effect: "NoSchedule"
      containers:
        - name: frontend
          image: localhost/analytics-frontend-modern:1.0
          imagePullPolicy: Never
          ports:
            - containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
  name: analytics-frontend-modern
  namespace: analytics-system
spec:
  type: NodePort
  selector:
    app: analytics-frontend-modern
  ports:
    - port: 80
      targetPort: 80
      nodePort: 30082
